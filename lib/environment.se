#!/bin/bash

check_environment() {

    info "Kontrollerar miljön..."

    local directories=(
         "$SCRIPT_DIR/packages"
         "$SCRIPT_DIR/lib"
         "$SCRIPT_DIR/config"
    )

     for dir in "${directories[@]}"; do
        if [[ -d "$dir" ]]; then
            success "Hittade $(basename "$dir")/"
        else
            error "Saknar $(basename "$dir")/"
            exit 1
        fi
    done

    echo
}
